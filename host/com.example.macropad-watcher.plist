<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template LaunchAgent for the frontmost-app watcher script.

  Before installing:
    1. Replace every "/path/to/macropad-frontmost-switcher" below with the
       absolute path where you cloned/copied this project.
    2. Copy this file to ~/Library/LaunchAgents/, then run:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.macropad-watcher.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.macropad-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/macropad-frontmost-switcher/host/.venv/bin/python3</string>
        <string>/path/to/macropad-frontmost-switcher/host/frontmost_watcher.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/macropad-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/macropad-watcher.err</string>
</dict>
</plist>
